{
  "version": 2,
  "routes": [
    {
      "src": "/manifest.json",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/manifest+json; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/(service-worker|sw)\\.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
